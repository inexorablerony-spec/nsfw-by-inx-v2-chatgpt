+package io.github.aedev.flow.providers
+
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.ByteArrayInputStream
+import java.io.IOException
+import java.net.HttpURLConnection
+import java.net.URL
+
+class EpornerProviderTest {
+    @Test
+    fun `provider metadata satisfies the complete provider info contract`() {
+        val info = EpornerProvider().getInfo(enabled = true)
+
+        assertEquals("Eporner", info.name)
+        assertEquals("eporner", info.value)
+        assertEquals("1.0", info.version)
+        assertEquals("Eporner video provider", info.description)
+        assertTrue(info.icon.startsWith("https://"))
+        assertTrue(info.enabled)
+    }
+
+    @Test
+    fun `site page URLs require HTTPS and the Eporner host`() {
+        val provider = EpornerProvider()
+
+        assertEquals("www.eporner.com", provider.validateSitePageUrl("https://www.eporner.com/hd-porn/example/").host)
+        assertThrows(IllegalArgumentException::class.java) {
+            provider.validateSitePageUrl("http://www.eporner.com/hd-porn/example/")
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            provider.validateSitePageUrl("https://eporner.com.evil.example/video/")
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            provider.validateSitePageUrl("https://user@www.eporner.com/video/")
+        }
+    }
+
+    @Test
+    fun `search URL encodes query characters instead of replacing spaces with hyphens`() {
+        val provider = EpornerProvider()
+        val searchUrl = provider.searchUrl("cats and dogs & birds", 2)
+
+        assertTrue(searchUrl.contains("cats+and+dogs+%26+birds"))
+        assertTrue(searchUrl.endsWith("/2/"))
+    }
+
+    @Test
+    fun `catalogue parsing resolves links and deduplicates matching anchors`() {
+        val provider = EpornerProvider()
+        val html = """
+            <div>
+              <a href="/hd-porn/video-one/"><img alt="One &amp; Only" data-src="/thumb-one.jpg"></a>
+              <a href="/hd-porn/video-one/"><img alt="Duplicate" src="/duplicate.jpg"></a>
+              <a href="/hd-porn/video-two/"><img alt="Two" src="https://cdn.example/two.webp"></a>
+            </div>
+        """.trimIndent()
+
+        val posts = provider.parsePosts(html)
+
+        assertEquals(2, posts.size)
+        assertEquals("One & Only", posts.first().title)
+        assertEquals("https://www.eporner.com/hd-porn/video-one/", posts.first().link)
+        assertEquals("https://www.eporner.com/thumb-one.jpg", posts.first().image)
+    }
+
+    @Test
+    fun `direct media links are returned without opening an HTTP connection`() = runBlocking {
+        var openedConnection = false
+        val provider = EpornerProvider {
+            openedConnection = true
+            throw AssertionError("A direct stream must not be fetched as HTML")
+        }
+
+        val streams = provider.getStream("https://cdn.example/path/video.m3u8?token=abc")
+
+        assertFalse(openedConnection)
+        assertEquals(1, streams.size)
+        assertEquals("m3u8", streams.single().type)
+        assertEquals("https://cdn.example/path/video.m3u8?token=abc", streams.single().link)
+        assertNotNull(streams.single().headers?.get("Referer"))
+    }
+
+    @Test
+    fun `stream extraction normalizes escaped links filters previews and deduplicates`() {
+        val provider = EpornerProvider()
+        val html = """
+            source: "https:\/\/cdn.example\/media\/main.mp4?token=1\u0026x=2";
+            source2: "https://cdn.example/media/main.mp4?token=1&x=2";
+            preview: "https://cdn.example/media/preview.mp4";
+            hls: "https://cdn.example/media/master.m3u8";
+        """.trimIndent()
+
+        val streams = provider.extractStreams(html, "https://www.eporner.com/hd-porn/example/")
+
+        assertEquals(2, streams.size)
+        assertEquals("mp4", streams[0].type)
+        assertEquals("https://cdn.example/media/main.mp4?token=1&x=2", streams[0].link)
+        assertEquals("m3u8", streams[1].type)
+        assertEquals("https://www.eporner.com/hd-porn/example/", streams[0].headers?.get("Referer"))
+    }
+
+    @Test
+    fun `HTTP failure still disconnects the connection`() = runBlocking {
+        lateinit var connection: StubConnection
+        val provider = EpornerProvider { url ->
+            StubConnection(url, 403, "forbidden").also { connection = it }
+        }
+
+        val error = try {
+            provider.getPosts()
+            throw AssertionError("Expected the HTTP failure to be propagated")
+        } catch (expected: ProviderOperationException) {
+            expected
+        }
+
+        assertTrue(error.message.orEmpty().contains("Eporner catalogue loading failed"))
+        assertTrue(error.cause is IOException)
+        assertTrue(connection.wasDisconnected)
+    }
+
+    @Test
+    fun `redirect to a non Eporner host is rejected and connection is closed`() = runBlocking {
+        lateinit var connection: StubConnection
+        val provider = EpornerProvider { url ->
+            StubConnection(url, 302, "").also {
+                it.redirectLocation = "https://evil.example/redirected"
+                connection = it
+            }
+        }
+
+        val error = try {
+            provider.getPosts()
+            throw AssertionError("Expected external redirect to be rejected")
+        } catch (expected: ProviderOperationException) {
+            expected
+        }
+
+        assertTrue(error.cause is IllegalArgumentException)
+        assertTrue(connection.wasDisconnected)
+    }
+
+    @Test
+    fun `successful HTTP response disconnects after reading`() = runBlocking {
+        lateinit var connection: StubConnection
+        val provider = EpornerProvider { url ->
+            StubConnection(url, 200, "<html></html>").also { connection = it }
+        }
+
+        assertTrue(provider.getPosts().isEmpty())
+        assertTrue(connection.wasDisconnected)
+        assertEquals(10_000, connection.connectTimeout)
+        assertEquals(15_000, connection.readTimeout)
+    }
+
+    private class StubConnection(
+        url: URL,
+        private val status: Int,
+        private val body: String
+    ) : HttpURLConnection(url) {
+        var wasDisconnected = false
+            private set
+        var redirectLocation: String? = null
+
+        override fun connect() = Unit
+        override fun disconnect() { wasDisconnected = true }
+        override fun usingProxy(): Boolean = false
+        override fun getResponseCode(): Int = status
+        override fun getHeaderField(name: String?): String? = if (name.equals("Location", ignoreCase = true)) redirectLocation else null
+        override fun getInputStream() = ByteArrayInputStream(body.toByteArray(Charsets.UTF_8))
+    }
+}

--- a/app/src/test/java/io/github/aedev/flow/providers/UnifiedCatalogueRepositoryTest.kt
+++ b/app/src/test/java/io/github/aedev/flow/providers/UnifiedCatalogueRepositoryTest.kt
@@ -0,0 +1,179 @@
+package io.github.aedev.flow.providers
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class UnifiedCatalogueRepositoryTest {
+    @Test
+    fun `one failed provider does not discard another provider successful results`() = runTest {
+        val good = FakeProvider("Good", "good", posts = listOf(Post("Video", "https://good.example/video", "")))
+        val bad = FakeProvider("Bad", "bad", postsFailure = IllegalStateException("network down"))
+        val repository = repository(listOf(good, bad), setOf("good", "bad"))
+
+        val result = repository.getHomeFeed()
+
+        assertEquals(1, result.items.size)
+        assertEquals("good", result.items.single().providerId)
+        assertEquals(1, result.errors.size)
+        assertTrue(result.errors.single().contains("Bad"))
+        assertTrue(result.errors.single().contains("network down"))
+    }
+
+    @Test
+    fun `legitimate empty catalogue has no provider errors`() = runTest {
+        val empty = FakeProvider("Empty", "empty")
+        val result = repository(listOf(empty), setOf("empty")).getHomeFeed()
+
+        assertTrue(result.items.isEmpty())
+        assertTrue(result.errors.isEmpty())
+    }
+
+    @Test
+    fun `cancellation is propagated instead of being reported as provider failure`() = runTest {
+        val cancelled = FakeProvider("Cancelled", "cancelled", postsFailure = CancellationException("caller cancelled"))
+        val repository = repository(listOf(cancelled), setOf("cancelled"))
+
+        assertSuspendThrows(CancellationException::class.java) {
+            repository.getHomeFeed()
+        }
+    }
+
+    @Test
+    fun `providers without catalogue capability are not queried`() = runTest {
+        val webView = FakeProvider("WebView", "webview", catalogue = false)
+        val result = repository(listOf(webView), setOf("webview")).getHomeFeed()
+
+        assertEquals(0, webView.postsCalls)
+        assertTrue(result.items.isEmpty())
+        assertTrue(result.errors.isEmpty())
+    }
+
+    @Test
+    fun `disabled provider cannot serve direct catalogue requests`() = runTest {
+        val provider = FakeProvider("Disabled", "disabled")
+        val repository = repository(listOf(provider), emptySet())
+
+        assertSuspendThrows(ProviderUnavailableException::class.java) {
+            repository.getProviderPosts("disabled")
+        }
+        assertEquals(0, provider.postsCalls)
+    }
+
+    @Test
+    fun `disabled provider cannot serve direct search requests`() = runTest {
+        val provider = FakeProvider("Disabled", "disabled")
+        val repository = repository(listOf(provider), emptySet())
+
+        assertSuspendThrows(ProviderUnavailableException::class.java) {
+            repository.searchProvider("disabled", "cats")
+        }
+        assertEquals(0, provider.searchCalls)
+    }
+
+    @Test
+    fun `unsupported catalogue providers reject direct feed calls clearly`() = runTest {
+        val provider = FakeProvider("WebView", "webview", catalogue = false)
+        val repository = repository(listOf(provider), setOf("webview"))
+
+        assertSuspendThrows(ProviderOperationException::class.java) {
+            repository.getProviderPosts("webview")
+        }
+        assertEquals(0, provider.postsCalls)
+    }
+
+    @Test
+    fun `disabled provider cannot serve metadata`() = runTest {
+        val provider = FakeProvider("Disabled", "disabled")
+        val repository = repository(listOf(provider), emptySet())
+        val item = ProviderCatalogueItem("disabled", "Disabled", Post("Video", "https://example.com/video", ""))
+
+        assertSuspendThrows(ProviderUnavailableException::class.java) {
+            repository.getDetails(item)
+        }
+        assertEquals(0, provider.metaCalls)
+    }
+
+    @Test
+    fun `disabled provider cannot resolve playback streams`() = runTest {
+        val provider = FakeProvider("Disabled", "disabled")
+        val repository = repository(listOf(provider), emptySet())
+        val item = ProviderCatalogueItem("disabled", "Disabled", Post("Video", "https://example.com/video", ""))
+
+        assertSuspendThrows(ProviderUnavailableException::class.java) {
+            repository.getStreams(item)
+        }
+        assertEquals(0, provider.streamCalls)
+    }
+
+    @Test
+    fun `catalogue deduplicates identical posts from the same provider`() = runTest {
+        val post = Post("Video", "https://example.com/video", "")
+        val provider = FakeProvider("Test", "test", posts = listOf(post, post))
+        val result = repository(listOf(provider), setOf("test")).getHomeFeed()
+
+        assertEquals(1, result.items.size)
+    }
+
+    private suspend fun <T : Throwable> assertSuspendThrows(
+        expected: Class<T>,
+        block: suspend () -> Any?
+    ): T {
+        try {
+            block()
+        } catch (error: Throwable) {
+            if (expected.isInstance(error)) return expected.cast(error)
+            throw error
+        }
+        throw AssertionError("Expected ${expected.simpleName} to be thrown")
+    }
+
+    private fun repository(providers: List<Provider>, enabled: Set<String>) =
+        UnifiedCatalogueRepository(
+            enabledProviders = { providers },
+            providerLookup = { id -> providers.firstOrNull { it.value == id } },
+            isProviderEnabled = { it in enabled }
+        )
+
+    private class FakeProvider(
+        override val name: String,
+        override val value: String,
+        private val posts: List<Post> = emptyList(),
+        private val postsFailure: Throwable? = null,
+        catalogue: Boolean = true
+    ) : Provider {
+        override val version = "test"
+        override val description = "test provider"
+        override val icon = ""
+        override val supportsCatalogue = catalogue
+        override val supportsSearch = catalogue
+
+        var postsCalls = 0
+        var searchCalls = 0
+        var metaCalls = 0
+        var streamCalls = 0
+
+        override suspend fun getPosts(page: Int): List<Post> {
+            postsCalls++
+            postsFailure?.let { throw it }
+            return posts
+        }
+
+        override suspend fun getSearchPosts(query: String, page: Int): List<Post> {
+            searchCalls++
+            return posts
+        }
+
+        override suspend fun getMeta(link: String): Info {
+            metaCalls++
+            return Info("Title", "", "", "", "movie", emptyList())
+        }
+
+        override suspend fun getStream(link: String): List<Stream> {
+            streamCalls++
+            return listOf(Stream("Test", "https://cdn.example/video.mp4", "mp4"))
+        }
+    }
+}

--- a/app/src/test/java/io/github/aedev/flow/providers/WebViewProviderUrlTest.kt
+++ b/app/src/test/java/io/github/aedev/flow/providers/WebViewProviderUrlTest.kt
@@ -0,0 +1,120 @@
+package io.github.aedev.flow.providers
+
+import androidx.test.core.app.ApplicationProvider
+import android.content.Context
+import io.github.aedev.flow.webview.ExtractionResult
+import io.github.aedev.flow.webview.MediaCandidate
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+
+@RunWith(RobolectricTestRunner::class)
+class WebViewProviderUrlTest {
+    private val context: Context
+        get() = ApplicationProvider.getApplicationContext()
+
+    @Test
+    fun `bare website URL is normalized to HTTPS`() {
+        assertEquals(
+            "https://example.com/watch?id=42",
+            WebViewProvider.normalizeInputUrl(" example.com/watch?id=42 ")
+        )
+    }
+
+    @Test
+    fun `explicit HTTP and HTTPS URLs are preserved`() {
+        assertEquals("http://example.com/video", WebViewProvider.normalizeInputUrl("http://example.com/video"))
+        assertEquals("https://example.com/video", WebViewProvider.normalizeInputUrl("https://example.com/video"))
+    }
+
+    @Test
+    fun `non web schemes and malformed URLs are rejected`() {
+        assertNull(WebViewProvider.normalizeInputUrl("javascript:alert(1)"))
+        assertNull(WebViewProvider.normalizeInputUrl("file:///etc/passwd"))
+        assertNull(WebViewProvider.normalizeInputUrl("https://user:pass@example.com/video"))
+        assertNull(WebViewProvider.normalizeInputUrl("https:///missing-host"))
+        assertNull(WebViewProvider.normalizeInputUrl("   "))
+    }
+
+    @Test
+    fun `normalized URL has a host and HTTP scheme`() {
+        val normalized = WebViewProvider.normalizeInputUrl("example.com")
+        assertTrue(normalized.orEmpty().startsWith("https://"))
+    }
+
+    @Test
+    fun `extractor failures are surfaced instead of becoming empty stream lists`() = runBlocking {
+        val provider = WebViewProvider(context) {
+            ExtractionResult.Error("No media found", ExtractionResult.ErrorType.NO_MEDIA_FOUND)
+        }
+
+        val error = assertSuspendThrows(ProviderOperationException::class.java) {
+            provider.getStream("example.com/watch")
+        }
+
+        assertTrue(error.message.orEmpty().contains("WebView stream extraction"))
+        assertTrue(error.message.orEmpty().contains("No media found"))
+    }
+
+    @Test
+    fun `successful extraction retains referer user agent and cookies`() = runBlocking {
+        val candidate = MediaCandidate(
+            url = "https://cdn.example/video.mp4",
+            type = "mp4",
+            sourcePage = "https://example.com/watch",
+            userAgent = "TestAgent",
+            referer = "https://example.com/watch",
+            cookies = "session=abc"
+        )
+        val provider = WebViewProvider(context) { ExtractionResult.Success(listOf(candidate)) }
+
+        val stream = provider.getStream("example.com/watch").single()
+
+        assertEquals(candidate.url, stream.link)
+        assertEquals("TestAgent", stream.headers?.get("User-Agent"))
+        assertEquals(candidate.referer, stream.headers?.get("Referer"))
+        assertEquals("session=abc", stream.headers?.get("Cookie"))
+    }
+
+    @Test
+    fun `invalid URL is rejected before extraction starts`() = runBlocking {
+        var extractorCalled = false
+        val provider = WebViewProvider(context) {
+            extractorCalled = true
+            ExtractionResult.Success(emptyList())
+        }
+
+        assertSuspendThrows(ProviderOperationException::class.java) {
+            provider.getStream("javascript:alert(1)")
+        }
+        assertFalse(extractorCalled)
+    }
+
+    @Test
+    fun `cancellation from the extractor is propagated`() = runBlocking {
+        val provider = WebViewProvider(context) { throw CancellationException("caller cancelled") }
+
+        assertSuspendThrows(CancellationException::class.java) {
+            provider.getStream("example.com/watch")
+        }
+    }
+
+    private suspend fun <T : Throwable> assertSuspendThrows(
+        expected: Class<T>,
+        block: suspend () -> Any?
+    ): T {
+        try {
+            block()
+        } catch (error: Throwable) {
+            if (expected.isInstance(error)) return expected.cast(error)
+            throw error
+        }
+        throw AssertionError("Expected ${expected.simpleName} to be thrown")
+    }
+}

